# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/echoboard?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Configuration
# Option 1: Mailgun SMTP (requires domain verification to send to any email)
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_SECURE=false
MAILGUN_SMTP_USER=your_mailgun_smtp_username
MAILGUN_SMTP_PASSWORD=your_mailgun_smtp_password
EMAIL_FROM="EchoBoard" <noreply@yourdomain.com>

# Option 2: Gmail SMTP (easier setup, works immediately, ~500 emails/day limit)
# Set USE_GMAIL_SMTP=true to use Gmail instead of Mailgun
# USE_GMAIL_SMTP=false
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# EMAIL_FROM="EchoBoard" <your-email@gmail.com>

